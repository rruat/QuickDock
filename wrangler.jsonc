{
  // QuickDock no Cloudflare Pages (quickdock.pages.dev). Projeto separado do "nexus".
  // O site é a pasta `dist-pages/` (montada por `npm run build:pages`); a API de login fica em
  // `functions/` e conversa com o D1. O D1 guarda só sessões e o refresh token do Google, cifrado:
  // as notas ficam no Drive de cada pessoa.
  "name": "quickdock",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./dist-pages",

  "vars": {
    // id do cliente OAuth "Aplicativo da Web" (público; o segredo é GOOGLE_CLIENT_SECRET)
    "GOOGLE_CLIENT_ID": "324044251913-omlvbssk3av45rafji6evt6kmlev22pf.apps.googleusercontent.com"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "quickdock", "database_id": "413752e0-e4ff-4244-9767-1809bae7886f", "migrations_dir": "migrations" }
  ]

  // Segredos (nunca neste arquivo): wrangler pages secret put GOOGLE_CLIENT_SECRET --project-name quickdock
  //                                  wrangler pages secret put TOKEN_ENC_KEY        --project-name quickdock
}
